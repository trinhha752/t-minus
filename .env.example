# Copy to .env.local and fill in. Never commit .env.local.
MBTA_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=
# Local dev only: serve trivia nobody has verified yet. Ignored in production.
ALLOW_UNVERIFIED_TRIVIA=0
# Photo quests: Gemini models to try in order (comma-separated). Blank = gemini-3.6-flash,gemini-3.1-flash-lite.
# New API keys can't use gemini-2.5 or older.
GEMINI_MODEL=
# Show the 'pass without camera' button in production builds (for the stage demo).
NEXT_PUBLIC_DEMO_MODE=0
