# Copy to .env.local and fill in. Never commit .env.local.
MBTA_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=
# Local dev only: serve trivia nobody has verified yet. Ignored in production.
ALLOW_UNVERIFIED_TRIVIA=0
# Photo quests: Gemini model with image input. Leave blank for the default (gemini-3.8-flash).
GEMINI_MODEL=
# Show the 'pass without camera' button in production builds (for the stage demo).
NEXT_PUBLIC_DEMO_MODE=0
